def refresh_all_widgets(obj, is_root=True, processed=None):
    """
    Actualiza widgets en dos fases para evitar ciclos.
    Primero actualiza el objeto actual y sus hijos directos,
    luego los padres (si is_root=False no sube de nuevo)
    """
    if processed is None:
        processed = set()
    
    obj_id = id(obj)
    if obj_id in processed:
        return
    processed.add(obj_id)
    
    # FASE 1: Actualizar fields del objeto actual
    for field in getattr(obj, "fields", {}).values():
        if hasattr(field, "_refresh_callbacks"):
            for callback in field._refresh_callbacks:
                try:
                    callback()
                except Exception as e:
                    print(f"Error: {e}")
    
    # FASE 2: Actualizar hijos (pero no volver al padre)
    for attr_name in ["winding", "coil", "conductor", "core", "cooling", 
                      "tests", "costs", "gradients", "guarantee", "losses", "mechanical"]:
        attr = getattr(obj, attr_name, None)
        if attr:
            if isinstance(attr, list):
                for item in attr:
                    refresh_all_widgets(item, is_root=False, processed=processed)
            else:
                refresh_all_widgets(attr, is_root=False, processed=processed)
    
    # FASE 3: Si es el objeto raíz, actualizar device (pero como hijo, no como padre)
    if is_root and hasattr(obj, 'device') and obj.device and obj.device is not obj:
        # Actualizar device pero como hijo, no como raíz
        refresh_all_widgets(obj.device, is_root=False, processed=processed)

def add_dynamic_restore(widget, parent_obj,field,widget_var=None, get_default_func=None):
    """
    Adds a context menu to a widget to restore a dynamic default value.
    - widget: Entry, Combobox, or Checkbutton
    - widget_var: associated variable (for Checkbutton)
    - get_default_func: function that returns the default value to restore
    """
    def restore():
        if get_default_func is not None:
            default_value = get_default_func()
        else:
            # Fallback: use current value
            if isinstance(widget, (tk.Entry, ttk.Combobox)):
                default_value = widget.get()
            elif isinstance(widget, tk.Checkbutton) and widget_var is not None:
                default_value = widget_var.get()
            else:
                default_value = None

        # --- Normalize Enum values to string for display ---
        if isinstance(default_value, Enum):
            default_display = default_value.value
        # elif hasattr(default_value, "name"):
        #     default_display = default_value.name
        # elif hasattr(default_value, "value"):
        #     default_display = str(default_value.value)
        else:
            default_display = str(default_value)

        # --- Restore according to widget type ---
        if isinstance(widget, ttk.Combobox):
            values = widget.cget("values")
            # Buscar coincidencia exacta o por texto
            if default_display in values:
                widget.set(default_display)
            elif str(default_value) in values:
                widget.set(str(default_value))
            else:
                # Valor no esta en la lista, asignar texto directo
                widget.set(default_display)

            # Simular evento de selección para actualizar backend
            #widget.event_generate("<<ComboboxSelected>>")

        elif isinstance(widget, tk.Entry):
            widget_var.set(default_display)
            #widget.delete(0, tk.END)
            #widget.insert(0, default_display)
        elif isinstance(widget, tk.Checkbutton) and widget_var is not None:
            # Convertir Enum a boolean si aplica
            if hasattr(default_value, "name"):
                widget_var.set(default_value.name.lower() in ["true", "yes", "1"])
            else:
                widget_var.set(bool(default_value))

        field.reset()

        field._updating_var = False

        if hasattr(parent_obj, "device") and parent_obj.device:
            parent_obj.device.calculate_device()
            parent_obj.device.calculate_device()
            refresh_all_widgets(parent_obj.device)

    # --- Context menu setup ---
    menu = tk.Menu(widget, tearoff=0)
    menu.add_command(label="Restore Default", command=restore)

    def show_menu(event):
        menu.tk_popup(event.x_root, event.y_root)

    widget.bind("<Button-3>", show_menu)  # Right-click (Windows/Linux)
    widget.bind("<Button-2>", show_menu)  # Middle-click (Mac)

def apply_warning_color(widget, warning_func=None, iIndex=None,bOutput =None,bInfo=None):
    if warning_func is None:
        return
    
    style = ttk.Style()

    bComboBox = True if isinstance(widget, ttk.Combobox) else False
    d_Value = [0.0,0.0]
    results = []

    if isinstance(warning_func, (list, tuple, set)):    # 🔥 VARIAS FUNCIONES
        for func in warning_func:
            res = func(iIndex, d_Value) if iIndex is not None else func(d_Value)
            if isinstance(res, (list, tuple)):          # si una función regresa varios
                results.extend(res)
            else:
                results.append(res)
    else:                                              # 🔥 SOLO UNA FUNCIÓN
        result = warning_func(iIndex, d_Value) if iIndex is not None else warning_func(d_Value)
        results = result if isinstance(result, (list, tuple)) else [result]

    color = None
    justifyE = None #"right"
    colorName = None
    color = None

    if bOutput:  
        colorName = "Green.TCombobox"
        color = "green"
    if bInfo:
        colorName = "Black.TCombobox"
        color = "black"
        justifyE = "center"

    if eWarnings.eERROR in results:
        colorName = "Red.TCombobox"
        color = "red"
    elif eWarnings.eWARNING in results:
        colorName = "Blue.TCombobox"
        color = "blue"
    elif eWarnings.eNONE in results and bOutput==False:
        colorName = "Black.TCombobox"
        color = "black"

    if bComboBox and colorName is not None:
        style.configure(colorName, foreground=color)
        widget.config(style=colorName)
    elif isinstance(widget, tk.Entry) or isinstance(widget, tk.Label):
        widget.config(fg=color, disabledforeground=color, justify=justifyE)

def get_enum_safe(enum_class, selected):
    if isinstance(selected, enum_class):
        return selected

    # si es string con formato "eWindingSelection.NONE", extraemos "NONE"
    if isinstance(selected, str) and '.' in selected:
        selected = selected.split('.')[-1]

    # Primero por nombre
    try:
        return enum_class[selected]
    except KeyError:
        pass

    # Luego por valor
    try:
        return enum_class(selected)
    except ValueError:
        pass

class ToolTip:
    def __init__(self, widget, text):
        self.widget = widget
        self.text = text
        self.tipwindow = None
        widget.bind("<Enter>", self.show)
        widget.bind("<Leave>", self.hide)

    def show(self, event=None):
        if self.tipwindow or not self.text:
            return

        x = self.widget.winfo_rootx() + 20
        y = self.widget.winfo_rooty() + 20

        self.tipwindow = tw = tk.Toplevel(self.widget)
        tw.wm_overrideredirect(True)
        tw.wm_geometry(f"+{x}+{y}")

        label = tk.Label(
            tw,
            text=self.text,
            background="#f5f5f5",
            relief="solid",
            borderwidth=1,
            font=("Segoe UI", 8)
        )
        label.pack()

    def hide(self, event=None):
        if self.tipwindow:
            self.tipwindow.destroy()
            self.tipwindow = None